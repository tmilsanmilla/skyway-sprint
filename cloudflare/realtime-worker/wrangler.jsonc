{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "skyway-sprint-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH_ROOMS", "class_name": "MatchRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://skyway-sprint.vercel.app,https://skyway-sprint-neon-preview.vercel.app,https://skyway-sprint-p0dan7wl2-video-game-coder.vercel.app,http://localhost:3000",
    "ENVIRONMENT": "preview"
  }
}
